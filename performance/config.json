{
  "load": {
    "virtualUsers": 2,
    "duration": "30s"
  },
  "thresholds": {
    "maximumErrorRate": 0.01,
    "minimumCheckRate": 0.99,
    "loginP95Milliseconds": 1500,
    "employeeCreateP95Milliseconds": 2500
  },
  "login": {
    "path": "/auth/validate",
    "contentType": "application/json",
    "successStatus": 200,
    "payload": {
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "employee": {
    "path": "/api/v2/pim/employees",
    "createSuccessStatus": 200,
    "deleteSuccessStatuses": [200, 204],
    "payload": {
      "firstName": "{{firstName}}",
      "middleName": "Load",
      "lastName": "{{lastName}}"
    }
  },
  "reports": {
    "directory": "performance-results"
  }
}